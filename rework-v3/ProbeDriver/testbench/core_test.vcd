$var integer 32 ! test_trigger_count $end
$var integer 32 " test_auto_arm_count $end
$var integer 32 # test_error_count $end
$var integer 32 $ expected_status_transitions $end
$scope module uut $end
$var reg 1 % clk $end
$var reg 1 & reset $end
$comment test_phase is not handled $end
$var integer 32 ' cycle_count $end
$var reg 1 ( test_done $end
$var reg 1 ) core_enable $end
$var reg 1 * core_clk_en $end
$var reg 1 + core_status_clear $end
$var reg 7 , core_config_intensity_index[6:0] $end
$var reg 16 - core_config_pulse_duration[15:0] $end
$var reg 16 . core_config_cooldown_period[15:0] $end
$var reg 1 / core_probe_trigger_input $end
$var reg 1 0 core_probe_auto_arm $end
$var reg 16 1 core_probe_trigger_output[15:0] $end
$var reg 16 2 core_probe_intensity_output[15:0] $end
$var reg 16 3 core_probe_status_register[15:0] $end
$var reg 16 4 test_pulse_duration[15:0] $end
$var reg 16 5 test_cooldown_period[15:0] $end
$var reg 7 6 test_intensity_index[6:0] $end
$scope module uut_core $end
$var reg 1 7 clk $end
$var reg 1 8 reset $end
$var reg 1 9 enable $end
$var reg 1 : clk_en $end
$var reg 1 ; status_clear $end
$var reg 7 < config_intensity_index[6:0] $end
$var reg 16 = config_pulse_duration[15:0] $end
$var reg 16 > config_cooldown_period[15:0] $end
$var reg 1 ? probe_trigger_input $end
$var reg 1 @ probe_auto_arm $end
$var reg 16 A probe_trigger_output[15:0] $end
$var reg 16 B probe_intensity_output[15:0] $end
$var reg 16 C probe_status_register[15:0] $end
$comment current_state is not handled $end
$var reg 16 D pulse_counter[15:0] $end
$var reg 16 E cooldown_counter[15:0] $end
$var reg 16 F general_counter[15:0] $end
$var reg 7 G intensity_index[6:0] $end
$var reg 16 H pulse_duration[15:0] $end
$var reg 16 I cooldown_period[15:0] $end
$var reg 16 J status_reg[15:0] $end
$var reg 1 K reset_fired $end
$var reg 1 L fired_flag $end
$upscope $end
$scope module assertion_checks $end
$upscope $end
$upscope $end
$upscope $end
